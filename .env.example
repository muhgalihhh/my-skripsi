# ============================================
# Docker Compose Environment (Deployment)
# ============================================
# Copy this file to .env, then adjust the values.

# MySQL Credentials
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=skripsi_db
MYSQL_USER=skripsi
MYSQL_PASSWORD=change_me_app_password

# Port and Bind Address
# Keep MySQL/FastAPI on localhost for safer production defaults.
MYSQL_BIND_IP=127.0.0.1
MYSQL_PORT=3306

FASTAPI_BIND_IP=127.0.0.1
FASTAPI_PORT=8000

# Laravel is the only public web entry point.
LARAVEL_BIND_IP=0.0.0.0
LARAVEL_PORT=8080

# App Runtime
APP_ENV=production
APP_DEBUG=false
APP_URL=http://your-server-domain-or-ip:8080

# FastAPI CORS
CORS_ORIGINS=http://your-server-domain-or-ip:8080,http://laravel:8080

# Optional: custom env file paths per service
FASTAPI_ENV_FILE=./fastapi/.env
LARAVEL_ENV_FILE=./laravel-app/.env

# Important:
# Set APP_KEY inside laravel-app/.env (not in this root .env file).
