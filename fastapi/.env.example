# ============================================
# App Configuration
# ============================================
APP_NAME="Skripsi Topic Modeling API"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FASTAPI_API_KEY=change_me_fastapi_shared_key
FASTAPI_REQUIRE_API_KEY=true

# ============================================
# CORS (Laravel app URL)
# ============================================
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ============================================
# Data & Model Paths
# ============================================
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODELS_DIR=./app/ml/trained_models
RESULTS_DIR=./data/results
EMBEDDINGS_DIR=./data/embeddings

# ============================================
# Scraping Configuration
# ============================================
SCRAPING_BASE_URL=https://repository.unsoed.ac.id
SCRAPING_DELAY=2.0
SCRAPING_MAX_RETRIES=3

# ============================================
# Gemini (AI Topic Curation)
# ============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# Training Params Source
# ============================================
# Hyperparameter tuning diambil dari request/API,
# topic_model_settings (DB), atau schema default backend.
# Tidak lagi diset lewat .env.

# ============================================
# Runtime (Optional)
# ============================================
# Writable directory for NLTK download fallback
# NLTK_DATA_WRITABLE=/app/data/nltk_data
