# ============================================
# App Configuration
# ============================================
APP_NAME="Skripsi Topic Modeling API"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FASTAPI_API_KEY=change_me_fastapi_shared_key
FASTAPI_REQUIRE_API_KEY=true

# ============================================
# CORS (Laravel app URL)
# ============================================
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ============================================
# Data & Model Paths
# ============================================
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODELS_DIR=./app/ml/trained_models
RESULTS_DIR=./data/results
EMBEDDINGS_DIR=./data/embeddings

# ============================================
# Scraping Configuration
# ============================================
SCRAPING_BASE_URL=https://repository.unsoed.ac.id
SCRAPING_DELAY=2.0
SCRAPING_MAX_RETRIES=3

# ============================================
# Gemini (AI Topic Curation)
# ============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# BERTopic Configuration (defaults)
# ============================================
# Fondasi teori: IndoBERT (indobenchmark/indobert-base-p1)
# Engine sentence-embedding: IndoSBERT (Siamese Network dari IndoBERT)
BERTOPIC_EMBEDDING_MODEL=denaya/indoSBERT-large
BERTOPIC_MIN_TOPIC_SIZE=10
BERTOPIC_NR_TOPICS=auto
BERTOPIC_TOP_N_WORDS=10
BERTOPIC_EMBEDDING_BATCH_SIZE=16
BERTOPIC_SEED=42

# UMAP defaults
UMAP_N_NEIGHBORS=15
UMAP_N_COMPONENTS=5
UMAP_MIN_DIST=0.0
UMAP_METRIC=cosine
UMAP_RANDOM_STATE=42

# HDBSCAN defaults
HDBSCAN_MIN_CLUSTER_SIZE=10
HDBSCAN_MIN_SAMPLES=
HDBSCAN_CLUSTER_SELECTION_METHOD=eom

# ============================================
# LDA Configuration (defaults)
# ============================================
LDA_NUM_TOPICS=10
LDA_PASSES=15
LDA_ITERATIONS=400
LDA_CHUNKSIZE=100
LDA_RANDOM_STATE=42
LDA_ALPHA=auto
LDA_ETA=auto
LDA_NO_BELOW=5
LDA_NO_ABOVE=0.5

# ============================================
# Training Configuration
# ============================================
TRAINING_RANDOM_STATE=42

# ============================================
# Dynamic Topic Analysis (DTA)
# ============================================
DTA_YEAR_START=2019
DTA_YEAR_END=2025
DTA_EVOLUTION_TUNING=True
DTA_GLOBAL_TUNING=True
